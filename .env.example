# ─────────────────────────────────────────────────────────────
# DocuSphere environment
# Copy to .env  (docker-compose and both apps read this file)
# ─────────────────────────────────────────────────────────────

# ---- Postgres (pgvector) ----
POSTGRES_USER=docusphere
POSTGRES_PASSWORD=docusphere
POSTGRES_DB=docusphere
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://docusphere:docusphere@localhost:5432/docusphere

# ---- Redis / BullMQ ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
INGEST_QUEUE_NAME=docusphere:ingest
INGEST_CONCURRENCY=4

# ---- Object storage (MinIO / S3 compatible) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=docusphere-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# MinIO console: http://localhost:9001  (minioadmin / minioadmin)

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# ---- AI providers ----
# Embeddings: text-embedding-3-small -> 1536 dims (must match vector(1536) in schema)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
OPENAI_API_KEY=sk-...

# Chat model. LLM_PROVIDER = openai | anthropic | gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=<anthropic-messages-model-id>
# GEMINI_API_KEY=...
# LLM_MODEL=gemini-1.5-pro

# ---- Retrieval tuning ----
RETRIEVAL_TOP_K=8            # chunks fed to the model as grounded context
RETRIEVAL_CANDIDATES=40      # per-branch candidate pool before fusion
RRF_K=60                     # Reciprocal Rank Fusion constant
HNSW_EF_SEARCH=100           # pgvector recall/latency knob at query time
CHUNK_TOKENS=500
CHUNK_OVERLAP=50
MAX_UPLOAD_MB=25

# ---- Server / web ----
PORT=4000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:4000
